# Jooble REST API anahtari - https://jooble.org/api/about (ucretsiz)
JOOBLE_API_KEY=
# Her Jooble alan adi AYRI anahtar ister (jooble.org anahtari uk/de'de 403 verir)
JOOBLE_API_KEY_UK=
JOOBLE_API_KEY_DE=

# Upwork OAuth2 uygulama bilgileri (public erisim kapali)
# https://www.upwork.com/developer/keys/apply -> Key (Client ID) + Secret
# Doldurduktan sonra bir kez: py -m scanner upwork-auth
# Token data/upwork_token.json icinde saklanir ve kendiliginden yenilenir.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://localhost/callback
# Organizasyon baglami isteyen anahtarlar icin (cogu kurulumda gerekmez)
UPWORK_TENANT_ID=

# Adzuna - ucretsiz: https://developer.adzuna.com/

# Reed.co.uk - ucretsiz: https://www.reed.co.uk/developers
REED_API_KEY=

# Careerjet - ucretsiz ortak kimligi: https://www.careerjet.com/partners/api/
CAREERJET_AFFID=

# SMTP (gunluk proje raporu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=sen@firma.com
